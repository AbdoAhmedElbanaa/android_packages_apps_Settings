<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/camera_flash_notification_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="camera_flash_notification_main_switch"
        android:title="@string/camera_flash_notification_title" />

    <PreferenceCategory
        android:key="camera_flash_pattern_category"
        android:title="@string/camera_flash_notification_pattern_category">

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="camera_flash_notification_repeat"
            android:title="@string/camera_flash_notification_repeat_title"
            android:summary="%s"
            android:entries="@array/camera_flash_notification_repeat_entries"
            android:entryValues="@array/camera_flash_notification_repeat_values"
            android:defaultValue="2" />

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="camera_flash_notification_rate"
            android:title="@string/camera_flash_notification_rate_title"
            android:summary="%s"
            android:entries="@array/camera_flash_notification_rate_entries"
            android:entryValues="@array/camera_flash_notification_rate_values"
            android:defaultValue="2" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="camera_flash_intensity_category"
        android:title="@string/camera_flash_notification_intensity_category">

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="camera_flash_notification_strength"
            android:title="@string/camera_flash_notification_strength_title"
            android:summary="@string/camera_flash_notification_strength_summary"
            android:defaultValue="1"
            settings:min="1"
            settings:max="10" />

        <Preference
            android:key="camera_flash_fixed_intensity_info"
            android:title="@string/camera_flash_notification_strength_title"
            android:summary="@string/camera_flash_notification_fixed_strength_summary"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="camera_flash_preview_category"
        android:title="@string/camera_flash_notification_preview_category">

        <com.android.settingslib.widget.ButtonPreference
            android:key="camera_flash_notification_preview_btn"
            android:title="@string/camera_flash_notification_preview_btn"
            settings:buttonPreferenceType="filled"
            settings:buttonPreferenceSize="extra" />

        <Preference
            android:key="camera_flash_notification_reset_btn"
            android:title="@string/camera_flash_notification_reset_btn"
            android:summary="@string/camera_flash_notification_reset_btn_summary" />

    </PreferenceCategory>

</PreferenceScreen>
