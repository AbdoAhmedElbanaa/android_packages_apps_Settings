<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/bypass_charging_settings_title"
    android:key="bypass_charging_settings_screen"
    settings:keywords="@string/keywords_bypass_charging">

    <!-- Main Toggle -->
    <SwitchPreferenceCompat
        android:key="bypass_charging"
        android:title="@string/bypass_charging_title"
        settings:controller="com.android.settings.deviceinfo.batteryinfo.BypassChargingPreferenceController"/>

    <!-- Live Charging Status -->
    <PreferenceCategory
        android:key="bypass_live_status_category"
        android:title="@string/bypass_charging_live_status">

        <Preference
            android:key="bypass_charging_status"
            android:title="@string/battery_charging_status"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.settings.deviceinfo.batteryinfo.BatteryChargingStatusPreferenceController"
            settings:enableCopying="true"/>

        <Preference
            android:key="bypass_charge_type"
            android:title="@string/battery_charge_type"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.settings.deviceinfo.batteryinfo.BatteryChargingTypePreferenceController"
            settings:enableCopying="true"/>

        <Preference
            android:key="bypass_voltage"
            android:title="@string/battery_voltage"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.settings.deviceinfo.batteryinfo.BatteryVoltagePreferenceController"
            settings:enableCopying="true"/>

        <Preference
            android:key="bypass_current"
            android:title="@string/battery_current"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.settings.deviceinfo.batteryinfo.BatteryCurrentPreferenceController"
            settings:enableCopying="true"/>

        <Preference
            android:key="bypass_temperature"
            android:title="@string/battery_temperature"
            android:summary="@string/summary_placeholder"
            settings:controller="com.android.settings.deviceinfo.batteryinfo.BatteryTemperaturePreferenceController"
            settings:enableCopying="true"/>

    </PreferenceCategory>

    <!-- Footer — Explanation -->
    <com.android.settingslib.widget.FooterPreference
        android:key="bypass_charging_footer"
        android:title="@string/bypass_charging_footer"
        settings:searchable="false"/>

</PreferenceScreen>
