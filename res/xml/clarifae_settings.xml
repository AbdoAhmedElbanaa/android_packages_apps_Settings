<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="clarifae_settings_screen"
    android:title="@string/clarifae_title">

    <!-- Master Switch -->
    <com.android.settingslib.widget.MainSwitchPreference
        android:key="clarifae_master_switch"
        android:title="@string/clarifae_master_switch_title"
        android:order="-100"
        settings:controller="com.android.settings.sound.clarifae.ClarifaeMainSwitchPreferenceController" />

    <!-- Microphone Clarity (Input) -->
    <PreferenceCategory
        android:key="clarifae_mic_category"
        android:title="@string/clarifae_mic_category"
        android:order="-80">

        <SwitchPreferenceCompat
            android:key="clarifae_in_enabled"
            android:title="@string/clarifae_in_enabled_title"
            android:summary="@string/clarifae_in_enabled_summary"
            android:defaultValue="true"
            android:order="-79"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeMicSwitchPreferenceController" />

        <com.android.settings.widget.SeekBarPreference
            android:key="clarifae_strength"
            android:title="@string/clarifae_strength_title"
            android:defaultValue="70"
            android:max="100"
            settings:min="0"
            android:order="-78"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeStrengthPreferenceController" />
    </PreferenceCategory>

    <!-- Playback Clarity (Output) -->
    <PreferenceCategory
        android:key="clarifae_playback_category"
        android:title="@string/clarifae_playback_category"
        android:order="-60">

        <SwitchPreferenceCompat
            android:key="clarifae_out_enabled"
            android:title="@string/clarifae_out_enabled_title"
            android:summary="@string/clarifae_out_enabled_summary"
            android:defaultValue="false"
            android:order="-59"
            settings:controller="com.android.settings.sound.clarifae.ClarifaePlaybackSwitchPreferenceController" />

        <com.android.settings.widget.SeekBarPreference
            android:key="clarifae_out_strength"
            android:title="@string/clarifae_out_strength_title"
            android:defaultValue="50"
            android:max="100"
            settings:min="0"
            android:order="-58"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeOutStrengthPreferenceController" />
    </PreferenceCategory>

    <!-- Advanced Acoustic Tuning -->
    <PreferenceCategory
        android:key="clarifae_advanced_category"
        android:title="@string/clarifae_advanced_category"
        android:order="-40">

        <com.android.settings.widget.SeekBarPreference
            android:key="clarifae_atten_db"
            android:title="@string/clarifae_atten_db_title"
            android:defaultValue="24"
            android:max="60"
            settings:min="0"
            android:order="-39"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeAttenPreferenceController" />

        <com.android.settings.widget.SeekBarPreference
            android:key="clarifae_vad"
            android:title="@string/clarifae_vad_title"
            android:defaultValue="50"
            android:max="100"
            settings:min="0"
            android:order="-38"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeVadPreferenceController" />

        <SwitchPreferenceCompat
            android:key="clarifae_highpass"
            android:title="@string/clarifae_highpass_title"
            android:summary="@string/clarifae_highpass_summary"
            android:defaultValue="true"
            android:order="-37"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeHighpassPreferenceController" />

        <SwitchPreferenceCompat
            android:key="clarifae_autogain"
            android:title="@string/clarifae_autogain_title"
            android:summary="@string/clarifae_autogain_summary"
            android:defaultValue="false"
            android:order="-36"
            settings:controller="com.android.settings.sound.clarifae.ClarifaeAutogainPreferenceController" />
    </PreferenceCategory>

    <!-- Footer Information -->
    <com.android.settingslib.widget.FooterPreference
        android:key="clarifae_info_footer"
        android:title="@string/clarifae_info_footer"
        android:selectable="false"
        android:order="100" />

</PreferenceScreen>
